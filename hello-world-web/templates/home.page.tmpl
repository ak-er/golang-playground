{{template "base" .}}
{{define "css"}}
  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <style>
    /* Custom Styles */
    body {
      font-family: Arial, sans-serif;
    }

    .hero {
      background: linear-gradient(120deg, #6c63ff, #b3a1ff);
      color: white;
      padding: 100px 20px;
      text-align: center;
    }

    .hero h1 {
      font-size: 3rem;
    }

    .portfolio-card img {
      height: 200px;
      object-fit: cover;
    }

    footer {
      background: #333;
      color: #fff;
      text-align: center;
      padding: 20px 0;
    }
  </style>
  {{end}}

  {{define "content"}}
  <!-- Hero Section -->
  <header class="hero">
    <h1>Welcome to My Portfolio</h1>
    <p>Hi, I'm Akash Kumar, a Backend Developer passionate about coding and design.</p>
    <a href="#portfolio" class="btn btn-light mt-3">View My Work</a>
  </header>

  <!-- About Section -->
  <section id="about" class="container py-5">
    <h2 class="text-center mb-4">About Me</h2>
    <p>
      I am a software engineer specializing in Django backend development, React
      Native apps, and Kotlin-based solutions. I love building efficient and
      scalable applications.
    </p>
  </section>

  <!-- Portfolio Section -->
  <section id="portfolio" class="container py-5">
    <h2 class="text-center mb-4">Portfolio</h2>
    <div class="row g-4">
      <!-- Portfolio Item -->
      <div class="col-md-4">
        <div class="card portfolio-card">
          <img src="https://images.pexels.com/photos/3944405/pexels-photo-3944405.jpeg?auto=compress&cs=tinysrgb&w=350&h=233&dpr=1" class="card-img-top" alt="Project 1">
          <div class="card-body">
            <h5 class="card-title">Project 1</h5>
            <p class="card-text">A description of your awesome project.</p>
            <a href="#" class="btn btn-primary">View Project</a>
          </div>
        </div>
      </div>
      <!-- Portfolio Item -->
      <div class="col-md-4">
        <div class="card portfolio-card">
          <img src="https://images.pexels.com/photos/3944405/pexels-photo-3944405.jpeg?auto=compress&cs=tinysrgb&w=350&h=233&dpr=1" class="card-img-top" alt="Project 2">
          <div class="card-body">
            <h5 class="card-title">Project 2</h5>
            <p class="card-text">A description of another cool project.</p>
            <a href="#" class="btn btn-primary">View Project</a>
          </div>
        </div>
      </div>
      <!-- Portfolio Item -->
      <div class="col-md-4">
        <div class="card portfolio-card">
          <img src="https://images.pexels.com/photos/3944405/pexels-photo-3944405.jpeg?auto=compress&cs=tinysrgb&w=350&h=233&dpr=1" class="card-img-top" alt="Project 3">
          <div class="card-body">
            <h5 class="card-title">Project 3</h5>
            <p class="card-text">Yet another amazing project.</p>
            <a href="#" class="btn btn-primary">View Project</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="container py-5">
    <h2 class="text-center mb-4">Contact Me</h2>
    <form>
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" required />
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" id="email" required />
      </div>
      <div class="mb-3">
        <label for="message" class="form-label">Message</label>
        <textarea class="form-control" id="message" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Submit</button>
    </form>
  </section>

  <!-- Footer -->
  <footer>
    <p>© 2024 Akash Kumar. All Rights Reserved.</p>
  </footer>
  {{end}}

  {{define "js"}}

  <!-- Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
  ></script>
  {{end}}